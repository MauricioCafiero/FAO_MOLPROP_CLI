# Copy to .env and fill in. Real environment variables always override these.
# .env is only read from the directory you run molopt.py from.

# Ollama main model: bearer token for the hosted endpoint (https://ollama.com).
# Leave blank if you run a local daemon with --ollama-host http://localhost:11434.
OLLAMA_API_KEY=

# Adversary model keys. Only the one selected via --adversary is required.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=